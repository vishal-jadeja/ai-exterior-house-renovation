# ---- App ----
APP_ENV=dev
APP_NAME=renovation-api
LOG_LEVEL=INFO
JWT_SECRET=replace-with-a-long-random-string-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ---- Database (local compose default) ----
DATABASE_URL=postgresql+asyncpg://renov:renov@localhost:5433/renov

# ---- Object storage (S3-compatible: MinIO locally; Supabase Storage or R2 in cloud) ----
# Supabase (free, no card): S3_ENDPOINT_URL = S3_PUBLIC_ENDPOINT_URL =
#   https://<ref>.storage.supabase.co/storage/v1/s3 ; S3_REGION = your project region (not "auto").
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=renovation
S3_REGION=auto
PRESIGN_TTL_SECONDS=900

# ---- Upload limits ----
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_DIMENSION=4096
MIN_IMAGE_DIMENSION=640

# ---- AI providers (ALL optional; app runs fully without them) ----
# DETECTION_PROVIDER: segformer (local model, needs the ml extra) | gemini (hosted, no local
# weights — for lean free-tier deploys; requires GEMINI_API_KEY) | none (draw regions by hand).
DETECTION_PROVIDER=segformer
SEGMENTATION_ENABLED=true
SEGMENTATION_MODEL=Xpitfire/segformer-finetuned-segments-cmp-facade
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CF_ACCOUNT_ID=
CF_API_TOKEN=
FAL_KEY=
RENDER_PROVIDER_ORDER=fal,cloudflare,local

# ---- Worker ----
WORKER_POLL_SECONDS=1.0
JOB_MAX_ATTEMPTS=3

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:8000
