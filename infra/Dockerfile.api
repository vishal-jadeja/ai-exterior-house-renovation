# Multi-stage-ish: CPU-only torch keeps the image small enough for free tiers.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 HF_HOME=/models
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 fonts-dejavu-core curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
COPY apps/api/pyproject.toml ./
# --index-url (not --extra-index-url): pin torch/torchvision to the CPU-only build so pip can't
# resolve a multi-GB CUDA wheel from PyPI instead. --extra-index-url falls back to PyPI for their
# transitive deps (numpy, jinja2, sympy, …), which the CPU index doesn't host.
RUN pip install --index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.org/simple torch torchvision
# Real source (not a stub package) before `pip install .`, so the installed distribution matches
# what actually ships — a stub app/__init__.py here would build the layer from an empty package.
COPY apps/api/app ./app
RUN pip install ".[ml,report]"
COPY apps/api/ ./
RUN mkdir -p /models && useradd -m -u 1000 app && chown -R app:app /srv /models
USER app
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
