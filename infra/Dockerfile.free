# Slim image for 512 MB free tiers (Render, Koyeb, …): API + worker in one container, NO local
# ML model (no torch/transformers). SEGMENTATION_ENABLED=false skips SegFormer; set
# DETECTION_PROVIDER=gemini so the hosted Gemini model is the primary detector (fal/Cloudflare
# renders and the local compositor are all HTTP/CPU and still work). Listens on $PORT.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PORT=8000 \
    SEGMENTATION_ENABLED=false
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 fonts-dejavu-core curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
COPY apps/api/pyproject.toml ./
COPY apps/api/app ./app
# report extra for PDFs; google-genai alone (from the ml extra) for optional Gemini refinement.
RUN pip install ".[report]" "google-genai>=1.0"
COPY apps/api/ ./
COPY seed /srv/seed
COPY infra/space-entrypoint.sh /srv/entrypoint.sh
ENV SEED_DIR=/srv/seed
RUN useradd -m -u 1000 app && chown -R app:app /srv
USER app
EXPOSE 8000
CMD ["sh", "/srv/entrypoint.sh"]
